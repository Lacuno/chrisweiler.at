---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
	title: string;
	body: string;
	back: string;
	path: string;
}
const { title, body, back, path } = Astro.props;
const locale = Astro.currentLocale ?? 'de';
const home = getRelativeLocaleUrl(locale, '');
---

<Base title={title} path={path}>
	<Nav path={path} />
	<main class="msg container">
		<h1>{title}</h1>
		<p>{body}</p>
		<a href={home} class="btn btn--primary">{back}</a>
	</main>
	<Footer />
</Base>

<style>
	.msg {
		min-height: 55vh;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 1rem;
		padding-block: 4rem;
	}

	.msg h1 {
		font-size: 2.4rem;
	}

	.msg p {
		color: var(--muted);
		font-size: 1.15rem;
	}

	.msg .btn {
		margin-top: 1rem;
	}
</style>
