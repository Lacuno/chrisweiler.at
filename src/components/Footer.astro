---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n';
import { site } from '../data/site';

const locale = Astro.currentLocale ?? 'de';
const t = useTranslations(locale);
const imprint = getRelativeLocaleUrl(locale, locale === 'de' ? 'impressum' : 'imprint');
const privacy = getRelativeLocaleUrl(locale, locale === 'de' ? 'datenschutz' : 'privacy');
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container footer__grid">
		<address class="footer__col">
			<strong>{site.name}</strong>
			{site.address.map((line) => <span>{line}</span>)}
		</address>
		<div class="footer__col">
			<a href={imprint}>{t.footer.imprint}</a>
			<a href={privacy}>{t.footer.privacy}</a>
			<a href={site.cv} download>{t.footer.cv}</a>
			<span>© {year} {site.name}. {t.footer.rights}</span>
		</div>
		<div class="footer__social">
			<a href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
			</a>
			<a href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"/></svg>
			</a>
		</div>
	</div>
</footer>

<style>
	.footer {
		padding-block: 2.5rem;
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
		color: var(--muted);
	}

	.footer__grid {
		display: grid;
		grid-template-columns: 1fr 1fr auto;
		gap: 2rem;
		align-items: start;
	}

	.footer__col {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-style: normal;
	}

	.footer__col strong {
		color: var(--text);
	}

	.footer__social {
		display: flex;
		gap: 1rem;
	}

	.footer__social a {
		color: var(--muted);
	}

	.footer__social a:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.footer__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
