---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
	title: string;
	path: string;
}
const { title, path } = Astro.props;
---

<Base title={title} path={path}>
	<Nav path={path} />
	<main class="legal container">
		<h1>{title}</h1>
		<slot />
	</main>
	<Footer />
</Base>

<style>
	.legal {
		max-width: 720px;
		padding-block: 3.5rem 5rem;
	}

	.legal h1 {
		font-size: 2.2rem;
		margin-bottom: 2rem;
	}

	.legal :global(h2) {
		font-size: 1.3rem;
		margin-top: 2.25rem;
		margin-bottom: 0.6rem;
	}

	.legal :global(p),
	.legal :global(li) {
		color: var(--muted);
		margin-top: 0.6rem;
	}

	.legal :global(ul) {
		list-style: disc;
		padding-left: 1.4rem;
	}
</style>
